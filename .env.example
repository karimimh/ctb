SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass_or_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=you@example.com
STARTTLS=true

# Binance API credentials (leave blank for paper mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=


# Lookback window (completed candles) for channel highs/lows
BR_CHANNEL_LOOKBACK=20
# Regime EMAs
BR_FAST_EMA=21
BR_SLOW_EMA=100
# ATR period
BR_ATR_PERIOD=14
# Extra ATR buffer added above channel high for breakout trigger
BR_ENTRY_ATR_BUFFER=0.10
# Stop ATR multiple below channel low
BR_STOP_ATR_MULT=2.0
# Reward:Risk multiple for initial take profit
BR_REWARD_RISK=3.0
# Minimum ATR/Close ratio for sufficient volatility
BR_MIN_ATR_PCT=0.002
# Fraction of equity risked per breakout trade
BR_RISK_PER_TRADE_PCT=0.01
# Trailing activation: unrealized R multiple threshold
BR_TRAIL_ACTIVATE_RR=1.5
# Portion of R to lock once trailing active
BR_TRAIL_LOCK_RR=0.75
# Dynamic trailing component (ATR multiple proxy using initial risk)
BR_TRAIL_ATR_MULT=1.5
# Maximum holding period in candles
BR_MAX_HOLD_CANDLES=400
# Max simultaneous open positions for breakout strategy
BR_MAX_OPEN_POSITIONS=6
# Minimum cost (USD) to open a breakout position
BR_MIN_TRADE_ALLOCATION=10
