SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass_or_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=you@example.com
STARTTLS=true

# Binance API credentials (leave blank for paper mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=
SIM_SANDBOX=false

# Simulation parameters
SIM_INITIAL_CAPITAL=1000.0
SIM_TIMEFRAME=4h
SIM_RSI_PERIOD=14
SIM_SWING_K=2
SIM_CAPITAL_PER_TRADE=0.25
SIM_MAX_OPEN_POSITIONS=4
SIM_STOP_LOSS_PCT=0.05
SIM_TAKE_PROFIT_PCT=0.10
SIM_MAX_ENTRY_WAIT_CANDLES=3
SIM_MAX_HOLD_CANDLES=30
SIM_OPPORTUNITY_MIN_CANDLES=2
SIM_OPPORTUNITY_MAX_CANDLES=10
SIM_MIN_TRADE_ALLOCATION=10.0
SIM_DEFAULT_DAYS=365
SIM_SYMBOLS_LIMIT=


